# YouTube Live Streamer — Gaiverland Radio
# Copier en youtube.env et remplir la clé de stream YouTube
# NE PAS committer youtube.env dans le dépôt (contient la clé privée)

# Clé de stream YouTube Live (Studio YouTube → Diffusion en direct → Clé de stream)
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2/VOTRE_CLE_STREAM_ICI

# URL du stream Icecast (par défaut : interne Docker, à changer si AzuraCast externe)
ICECAST_STREAM_URL=http://azuracast:80/listen/gaiverlandradio/radio.mp3
