{
  "id": "gaiverland-radio",
  "name": "Gaiverland Radio IA",
  "category": "media",
  "channel": "stable",
  "repository": "gaiver-community",
  "description": "Radio électro autonome avec IA : analyse genre précise (Essentia + Discogs 400 classes), moteur de playlist intelligent, animatrice Rebexis (XTTS v2, voix féminine quasi-humaine, clonage vocal optionnel). Se connecte à AzuraCast existant ou le déploie automatiquement. Aucun GPU requis.",
  "capabilities": {
    "reverse_proxy": true,
    "gpu": false,
    "docker_socket": false,
    "privileged": false
  },
  "network": { "public": true, "internal": true },
  "ports": [
    { "name": "web",     "container": 80,   "dynamic": true },
    { "name": "sftp",    "container": 2022,  "dynamic": true },
    { "name": "icecast", "container": 8500,  "dynamic": true },
    { "name": "api",     "container": 8080,  "dynamic": true }
  ],
  "volumes": [
    {
      "source": "app-data/azuracast/stations",
      "target": "/var/azuracast/stations",
      "nas": true,
      "description": "Bibliothèque musicale AzuraCast — peut être volumineuse (Go à To)"
    },
    {
      "source": "app-data/azuracast/geoip",
      "target": "/var/azuracast/geoip",
      "nas": false
    },
    {
      "source": "app-data/azuracast/backups",
      "target": "/var/azuracast/backups",
      "nas": true,
      "description": "Sauvegardes AzuraCast"
    },
    {
      "source": "app-data/azuracast/acme",
      "target": "/var/azuracast/acme",
      "nas": false
    },
    {
      "source": "app-data/gaiverland-radio/db",
      "target": "/var/lib/postgresql/data",
      "nas": false,
      "description": "Base de données PostgreSQL — garder en local (latence I/O critique)"
    },
    {
      "source": "app-data/gaiverland-radio/tts-cache",
      "target": "/tts-cache",
      "nas": true,
      "description": "Cache des fichiers audio Rebexis générés"
    },
    {
      "source": "app-data/gaiverland-radio/ollama",
      "target": "/root/.ollama",
      "nas": true,
      "description": "Modèles LLM Ollama (2-8 Go selon modèle)"
    },
    {
      "source": "app-data/gaiverland-radio/essentia-models",
      "target": "/essentia-models",
      "nas": true,
      "description": "Modèles Essentia Discogs (~50 Mo)"
    }
  ],
  "backup": { "enabled": true }
}
